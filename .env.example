# Copy to .env and fill in. NEVER commit .env. SANDBOX CREDENTIALS ONLY.
# There is intentionally no setting for a live PayPal URL anywhere in this repo.

# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> your Merchant app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Spike script only (scripts/spike/spike.mjs) ---
# Email of a sandbox PERSONAL account that will receive the test payout.
# Must be different from the buyer account and from the merchant account.
SPIKE_PAYOUT_RECEIVER_EMAIL=
# Optional overrides (defaults shown)
# SPIKE_CURRENCY=USD
# SPIKE_DEPOSIT_CENTS=500
# SPIKE_RETURN_URL=https://example.com/spike-return

# --- Server (all optional except the PayPal pair above) ---
# PORT=3001
# APP_BASE_URL=http://localhost:5173      # the address people open (Vite in dev; http://localhost:3001 for `npm start`). Used in guest links and PayPal return URLs
# DATABASE_URL=file:./dev.db              # SQLite, relative to server/prisma/
# PAYOUT_FEE_PER_ITEM_CENTS=25            # reserved per payout item; the real fee is recorded afterwards
# MIN_PAYOUT_PER_PERSON_CENTS=100         # below this the pot is not paid out
# MAX_GUESTS=12
# EVENTS_PER_MINUTE=20                    # events one client may create per minute
# TRUST_PROXY=0                          # set to 1 behind one reverse proxy/host so rate limits see real client IPs
# CAPTURE_FEE_BPS=349                     # observed sandbox capture fee, only used for the pre-settlement estimate
# CAPTURE_FEE_FIXED_CENTS=49

# --- Added in later steps ---
# --- AI (Google Gemini via AI Studio, free tier is enough) ---
# Create a key at https://aistudio.google.com/apikey . Do not enable billing to stay on the free tier.
GEMINI_API_KEY=
# Model ids change often and older ones stop being offered to new accounts. List the ones your key can use:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=20000   # free-tier latency varies a lot (1 s to minutes); calls time out and retry once
