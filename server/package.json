{
  "name": "@flakeproof/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "ai:smoke": "tsx --env-file=../.env scripts/ai-smoke.ts",
    "ai:eval": "tsx --env-file=../.env scripts/ai-eval.ts",
    "e2e:sandbox": "node scripts/e2e-sandbox.mjs",
    "test": "vitest run",
    "db:generate": "node scripts/db.mjs generate",
    "db:migrate": "node scripts/db.mjs migrate dev",
    "db:deploy": "node scripts/db.mjs migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
